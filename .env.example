# Local accounts need no hosted authentication service or paid plan.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Optional secret override. Otherwise generated in .data/auth-secret.
BETTER_AUTH_SECRET=
# Optional absolute path to persistent local storage.
SECONDROUTE_DATA_DIR=
# Optional Google sign-in. Register this redirect URI with Google:
# http://127.0.0.1:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional outgoing mail, including Gmail SMTP with an app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional server-side assistance. Not required for core operations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Never put server secrets in NEXT_PUBLIC variables.
