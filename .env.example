# Demo is the only credential-free operating mode.
SECONDROUTE_MODE=demo
# Optional absolute path for durable local data. See backend defaults.
# SECONDROUTE_DATA_DIR=
# Connected mode requires a verified server auth implementation and memberships.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional maps and server-side assistance.
NEXT_PUBLIC_MAPBOX_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Never place server keys in NEXT_PUBLIC variables.
